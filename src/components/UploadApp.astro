---
interface Props {
  title?: string;
}

const {
  title = 'TeleImg'
} = Astro.props;
---

<section class="telegraph-page" data-landing-app>
  <div class="telegraph-background" aria-hidden="true">
    <div class="telegraph-background-slider" data-role="background-slider"></div>
  </div>

  <div class="telegraph-header">
    <a href="/admin" class="telegraph-header-link" aria-label="打开管理后台">
      <svg width="22" height="22" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <circle cx="24" cy="24" r="20" stroke="#fff" stroke-width="4" stroke-linecap="butt" stroke-linejoin="miter"></circle>
        <path d="M9 37L17 28L33 41" stroke="#fff" stroke-width="4" stroke-linecap="butt" stroke-linejoin="miter"></path>
        <circle cx="18" cy="17" r="4" fill="none" stroke="#fff" stroke-width="4"></circle>
        <path d="M24 33L32 23L42 31" stroke="#fff" stroke-width="4" stroke-linecap="butt" stroke-linejoin="miter"></path>
      </svg>
    </a>
  </div>

  <div class="telegraph-main">
    <div class="telegraph-hero-card">
      <span class="telegraph-eyebrow">Telegraph-style image host</span>
      <div class="telegraph-title">{title}</div>
      <p class="telegraph-copy">
        首页不再直接上传。请使用右上角进入 <code>/admin</code>，或通过 WebDAV 挂载来浏览、整理和管理文件。
      </p>
      <div class="telegraph-meta-row">
        <span>背景轮播保留</span>
        <span>右上角可直达管理台</span>
        <span>适合 WebDAV / Admin 双入口</span>
      </div>
    </div>
  </div>
</section>

<script is:inline>
(() => {
  const init = () => {
    document.querySelectorAll('[data-landing-app]').forEach((root) => {
      if (root.dataset.bound === 'true') return;
      root.dataset.bound = 'true';

      const backgroundSlider = root.querySelector('[data-role="background-slider"]');
      if (!backgroundSlider || backgroundSlider.dataset.loaded) {
        return;
      }

      backgroundSlider.dataset.loaded = 'true';
      fetch('/api/bing/wallpaper')
        .then((response) => response.json())
        .then((payload) => {
          const images = (payload?.data || []).slice(0, 5).map((item) => {
            return item?.url?.startsWith('http') ? item.url : `https://cn.bing.com${item?.url || ''}`;
          }).filter(Boolean);
          if (!images.length) return;

          let index = 0;
          backgroundSlider.style.backgroundImage = `url("${images[0]}")`;
          backgroundSlider.classList.add('is-loaded', 'is-visible');

          if (images.length > 1) {
            window.setInterval(() => {
              index = (index + 1) % images.length;
              backgroundSlider.classList.remove('is-visible');
              window.setTimeout(() => {
                backgroundSlider.style.backgroundImage = `url("${images[index]}")`;
                backgroundSlider.classList.add('is-visible');
              }, 220);
            }, 8000);
          }
        })
        .catch(() => {
          backgroundSlider.style.backgroundImage = '';
        });
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init, { once: true });
  } else {
    init();
  }
})();
</script>

<style>
  .telegraph-page {
    position: relative;
    min-height: 100vh;
    padding: 30px;
    overflow-x: hidden;
    background: linear-gradient(240deg, rgba(150, 50, 50, 0.3), rgba(0, 0, 200, 0));
  }

  .telegraph-background {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .telegraph-background-slider {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    background-size: cover;
    background-position: center center;
    background-repeat: no-repeat;
    background-attachment: fixed;
    opacity: 0;
    transition: opacity 0.6s ease;
    filter: saturate(1.02);
    transform: translateZ(0);
  }

  .telegraph-background-slider.is-loaded.is-visible {
    opacity: 1;
  }

  .telegraph-header,
  .telegraph-main {
    position: relative;
    z-index: 1;
  }

  .telegraph-header {
    display: flex;
    justify-content: flex-end;
    color: #fff;
  }

  .telegraph-header-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .telegraph-header svg {
    width: 28px;
    height: 28px;
    cursor: pointer;
  }

  .telegraph-header-link:hover {
    opacity: 0.78;
  }

  .telegraph-main {
    display: grid;
    min-height: calc(100vh - 60px);
    place-items: center;
    padding: 30px 0;
  }

  .telegraph-hero-card {
    width: min(640px, calc(100vw - 48px));
    padding: 36px 34px;
    border-radius: 28px;
    background: rgba(8, 8, 8, 0.52);
    border: 1px solid rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(18px);
    color: #fff;
    box-shadow: 0 24px 90px rgba(0, 0, 0, 0.3);
  }

  .telegraph-eyebrow {
    display: inline-flex;
    align-items: center;
    min-height: 30px;
    padding: 0 12px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.1);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .telegraph-title {
    font-family: "阿里妈妈数黑体 Bold", Inter, system-ui, sans-serif;
    color: #fff;
    font-size: clamp(40px, 8vw, 72px);
    font-weight: 700;
    line-height: 1.02;
    padding: 18px 0 14px;
  }

  .telegraph-copy {
    margin: 0;
    font-size: 15px;
    line-height: 1.8;
    color: rgba(255, 255, 255, 0.78);
  }

  .telegraph-copy code {
    padding: 2px 8px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.09);
    color: #fff;
  }

  .telegraph-meta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 24px;
  }

  .telegraph-meta-row span {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    padding: 0 12px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.06);
    color: rgba(255, 255, 255, 0.82);
    font-size: 13px;
  }

  @media (max-width: 520px) {
    .telegraph-page {
      padding: 18px;
    }

    .telegraph-hero-card {
      width: min(100%, calc(100vw - 24px));
      padding: 28px 22px;
      border-radius: 22px;
    }
  }
</style>
