<section class="telegraph-page" data-landing-app>
  <div class="telegraph-background" aria-hidden="true">
    <div class="telegraph-background-slider" data-role="background-slider"></div>
  </div>

  <div class="telegraph-header">
    <a href="/admin" class="telegraph-header-link" aria-label="打开管理后台">
      <svg width="22" height="22" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <circle cx="24" cy="24" r="20" stroke="#fff" stroke-width="4" stroke-linecap="butt" stroke-linejoin="miter"></circle>
        <path d="M9 37L17 28L33 41" stroke="#fff" stroke-width="4" stroke-linecap="butt" stroke-linejoin="miter"></path>
        <circle cx="18" cy="17" r="4" fill="none" stroke="#fff" stroke-width="4"></circle>
        <path d="M24 33L32 23L42 31" stroke="#fff" stroke-width="4" stroke-linecap="butt" stroke-linejoin="miter"></path>
      </svg>
    </a>
  </div>

  <div class="telegraph-main" aria-hidden="true"></div>
</section>

<script is:inline>
(() => {
  const init = () => {
    document.querySelectorAll('[data-landing-app]').forEach((root) => {
      if (root.dataset.bound === 'true') return;
      root.dataset.bound = 'true';

      const backgroundSlider = root.querySelector('[data-role="background-slider"]');
      if (!backgroundSlider || backgroundSlider.dataset.loaded) {
        return;
      }

      backgroundSlider.dataset.loaded = 'true';
      fetch('/api/bing/wallpaper')
        .then((response) => response.json())
        .then((payload) => {
          const images = (payload?.data || []).slice(0, 5).map((item) => {
            return item?.url?.startsWith('http') ? item.url : `https://cn.bing.com${item?.url || ''}`;
          }).filter(Boolean);
          if (!images.length) return;

          let index = 0;
          backgroundSlider.style.backgroundImage = `url("${images[0]}")`;
          backgroundSlider.classList.add('is-loaded', 'is-visible');

          if (images.length > 1) {
            window.setInterval(() => {
              index = (index + 1) % images.length;
              backgroundSlider.classList.remove('is-visible');
              window.setTimeout(() => {
                backgroundSlider.style.backgroundImage = `url("${images[index]}")`;
                backgroundSlider.classList.add('is-visible');
              }, 220);
            }, 8000);
          }
        })
        .catch(() => {
          backgroundSlider.style.backgroundImage = '';
        });
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init, { once: true });
  } else {
    init();
  }
})();
</script>

<style>
  .telegraph-page {
    position: relative;
    min-height: 100vh;
    padding: 30px;
    overflow-x: hidden;
    background: linear-gradient(240deg, rgba(150, 50, 50, 0.3), rgba(0, 0, 200, 0));
  }

  .telegraph-background {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .telegraph-background-slider {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    background-size: cover;
    background-position: center center;
    background-repeat: no-repeat;
    background-attachment: fixed;
    opacity: 0;
    transition: opacity 0.6s ease;
    filter: saturate(1.02);
    transform: translateZ(0);
  }

  .telegraph-background-slider.is-loaded.is-visible {
    opacity: 1;
  }

  .telegraph-header,
  .telegraph-main {
    position: relative;
    z-index: 1;
  }

  .telegraph-header {
    display: flex;
    justify-content: flex-end;
    color: #fff;
  }

  .telegraph-header-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .telegraph-header svg {
    width: 28px;
    height: 28px;
    cursor: pointer;
  }

  .telegraph-header-link:hover {
    opacity: 0.78;
  }

  .telegraph-main {
    min-height: calc(100vh - 60px);
  }

  @media (max-width: 520px) {
    .telegraph-page {
      padding: 18px;
    }
  }
</style>
