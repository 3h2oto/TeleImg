<section class="admin-shell admin-workspace" data-admin-app>
  <div class="admin-layout">
    <aside class="admin-side admin-side--left" data-role="left-panel">
      <div class="admin-side__top">
        <button type="button" class="ghost-button admin-collapse-button" data-action="toggle-tools" aria-expanded="true">
          收起侧栏
        </button>
      </div>

      <div class="admin-side__body">
        <div class="admin-brand">
          <span class="eyebrow">Dashboard</span>
          <h1>TeleImg Admin</h1>
          <p>功能区移到左侧；中间专注文件浏览，右侧专注目录树与 WebDAV 目录操作。</p>
        </div>

        <div class="toolbar-row admin-side__links">
          <a class="ghost-button link-button" href="/api/manage/logout">重新认证</a>
          <a class="ghost-button link-button" href="/">返回首页</a>
        </div>

        <section class="admin-side__section">
          <div class="admin-side__section-head">
            <strong>系统动作</strong>
          </div>
          <div class="toolbar-row admin-side__stack">
            <button type="button" class="ghost-button" data-action="refresh-folder">刷新当前目录</button>
            <button type="button" class="ghost-button" data-action="toggle-view">切换视图</button>
            <span class="meta-chip" data-role="view-chip">视图：grid</span>
          </div>
        </section>

        <section class="admin-side__section">
          <div class="admin-side__section-head">
            <strong>Telegram / 桥接</strong>
          </div>
          <div class="summary-row" data-role="telegram-summary">
            <button type="button" class="ghost-button" data-action="telegram-status">Telegram 状态</button>
            <button type="button" class="ghost-button" data-action="bridge-warmup">桥接自检</button>
            <button type="button" class="ghost-button" data-action="telegram-sync">同步直传</button>
            <button type="button" class="ghost-button" data-action="telegram-webhook">配置 Webhook</button>
          </div>
          <section class="bridge-panel" data-role="bridge-panel">
            <div class="bridge-panel__header">
              <strong>大文件桥接状态</strong>
              <span class="meta-chip">等待状态刷新</span>
            </div>
            <p class="muted-text">这里会显示当前大文件后端、授权状态、最近下载时间和健康检查结果。</p>
          </section>
        </section>
      </div>
    </aside>

    <main class="admin-center">
      <div class="admin-center__sticky">
        <div class="admin-center__heading">
          <div class="admin-breadcrumbs" data-role="breadcrumbs"></div>
          <div class="admin-folder-context" data-role="folder-context"></div>
        </div>

        <form class="search-bar admin-search-bar" data-role="search-form">
          <input type="search" name="search" placeholder="按 key、文件名、caption、聊天标题搜索当前目录（按 / 聚焦）" autocomplete="off" />
          <button type="submit" class="primary-button">搜索</button>
          <button type="button" class="ghost-button" data-action="reset-search">清空</button>
        </form>
      </div>

      <p class="status-line" data-role="status">正在加载...</p>
      <div class="summary-row admin-folder-summary" data-role="summary"></div>
      <div class="admin-grid" data-role="grid"></div>
    </main>

    <aside class="admin-side admin-side--right">
      <div class="admin-side__top">
        <div>
          <span class="eyebrow">WebDAV</span>
          <strong class="admin-side__title">目录树</strong>
        </div>
      </div>

      <div class="admin-side__body">
        <section class="admin-side__section">
          <div class="admin-side__section-head">
            <strong>目录操作</strong>
          </div>
          <div class="admin-folder-actions">
            <button type="button" class="ghost-button" data-action="root-folder">根目录</button>
            <button type="button" class="ghost-button" data-action="new-folder">新建目录</button>
            <button type="button" class="ghost-button danger" data-action="delete-folder">删除当前目录</button>
          </div>
        </section>

        <section class="admin-side__section">
          <div class="admin-side__section-head">
            <strong>目录树跳转</strong>
          </div>
          <div class="folder-tree" data-role="folder-tree"></div>
        </section>
      </div>
    </aside>
  </div>
</section>

<script is:inline>
(() => {
  const formatBytes = (value) => {
    const size = Number(value || 0);
    if (!size) return '0 B';
    const units = ['B', 'KB', 'MB', 'GB'];
    let index = 0;
    let current = size;
    while (current >= 1024 && index < units.length - 1) {
      current /= 1024;
      index += 1;
    }
    return `${current.toFixed(current >= 10 || index === 0 ? 0 : 1)} ${units[index]}`;
  };

  const formatTime = (value) => {
    const time = Number(value || 0);
    if (!time) return '未知时间';
    return new Intl.DateTimeFormat('zh-CN', {
      dateStyle: 'medium',
      timeStyle: 'short'
    }).format(new Date(time));
  };

  const isVideo = (name = '') => /\.(mp4|webm|mov|m4v)$/i.test(name);
  const isAudio = (name = '') => /\.(mp3|wav|ogg|m4a|flac)$/i.test(name);

  const normalizePath = (path) => {
    if (!path || path === '/') return '/';
    const parts = String(path).split('/').filter(Boolean);
    return parts.length ? `/${parts.join('/')}` : '/';
  };

  const getParentPath = (path) => {
    const normalized = normalizePath(path);
    if (normalized === '/') return null;
    const index = normalized.lastIndexOf('/');
    return index <= 0 ? '/' : normalized.slice(0, index);
  };

  const joinPath = (parentPath, leaf) => {
    const cleanLeaf = String(leaf || '').trim().replace(/^\/+|\/+$/g, '');
    if (!cleanLeaf) {
      return normalizePath(parentPath);
    }
    return normalizePath(parentPath) === '/' ? `/${cleanLeaf}` : `${normalizePath(parentPath)}/${cleanLeaf}`;
  };

  const davUrl = (path) => {
    const normalized = normalizePath(path);
    if (normalized === '/') return '/dav/';
    return `/dav/${normalized.slice(1).split('/').map((part) => encodeURIComponent(part)).join('/')}`;
  };

  const buildBreadcrumbs = (path) => {
    const normalized = normalizePath(path);
    if (normalized === '/') {
      return [{ path: '/', label: '根目录' }];
    }

    const parts = normalized.split('/').filter(Boolean);
    const crumbs = [{ path: '/', label: '根目录' }];
    let current = '';
    parts.forEach((part) => {
      current += `/${part}`;
      crumbs.push({ path: current, label: part });
    });
    return crumbs;
  };

  const matchesSearch = (item, search) => {
    if (!search) return true;
    const keyword = search.toLowerCase();
    const haystacks = [
      item.name,
      item.davPath,
      item.davName,
      item.metadata?.fileName,
      item.metadata?.caption,
      item.metadata?.uploader?.displayName,
      item.metadata?.telegram?.chatTitle,
      item.metadata?.telegram?.mediaKind,
      item.metadata?.source
    ].filter(Boolean).map((value) => String(value).toLowerCase());
    return haystacks.some((value) => value.includes(keyword));
  };

  const isEditableTarget = (target) => {
    if (!target || !(target instanceof HTMLElement)) return false;
    return target.isContentEditable || ['INPUT', 'TEXTAREA', 'SELECT'].includes(target.tagName);
  };

  const init = () => {
    document.querySelectorAll('[data-admin-app]').forEach((root) => {
      if (root.dataset.bound === 'true') return;
      root.dataset.bound = 'true';

      const status = root.querySelector('[data-role="status"]');
      const summary = root.querySelector('[data-role="summary"]');
      const telegramSummary = root.querySelector('[data-role="telegram-summary"]');
      const bridgePanel = root.querySelector('[data-role="bridge-panel"]');
      const grid = root.querySelector('[data-role="grid"]');
      const form = root.querySelector('[data-role="search-form"]');
      const breadcrumbs = root.querySelector('[data-role="breadcrumbs"]');
      const folderContext = root.querySelector('[data-role="folder-context"]');
      const folderTree = root.querySelector('[data-role="folder-tree"]');
      const viewChip = root.querySelector('[data-role="view-chip"]');
      const leftPanel = root.querySelector('[data-role="left-panel"]');
      const locationUrl = new URL(window.location.href);
      const initialView = locationUrl.searchParams.get('view') === 'waterfall' ? 'waterfall' : 'grid';
      const initialPath = normalizePath(locationUrl.searchParams.get('folder') || '/');

      const state = {
        view: initialView,
        search: locationUrl.searchParams.get('search') || '',
        currentPath: initialPath,
        currentBrowse: null,
        currentItems: [],
        folderCache: new Map(),
        expandedFolders: new Set(['/']),
        leftCollapsed: false
      };

      form.search.value = state.search;
      grid.dataset.view = state.view;
      viewChip.textContent = `视图：${state.view}`;

      const syncUrl = () => {
        const nextUrl = new URL(window.location.href);
        if (state.search) {
          nextUrl.searchParams.set('search', state.search);
        } else {
          nextUrl.searchParams.delete('search');
        }

        if (state.view && state.view !== 'grid') {
          nextUrl.searchParams.set('view', state.view);
        } else {
          nextUrl.searchParams.delete('view');
        }

        if (state.currentPath && state.currentPath !== '/') {
          nextUrl.searchParams.set('folder', state.currentPath);
        } else {
          nextUrl.searchParams.delete('folder');
        }

        history.replaceState({}, '', nextUrl);
      };

      const setStatus = (message, tone = 'idle') => {
        status.textContent = message;
        status.dataset.tone = tone;
      };

      const renderBridgePanel = (bridge) => {
        if (!bridgePanel) return;

        if (!bridge?.configured) {
          bridgePanel.innerHTML = `
            <div class="bridge-panel__header">
              <strong>大文件桥接状态</strong>
              <span class="meta-chip">未配置</span>
            </div>
            <p class="muted-text">当前主站没有配置 MTProto 大文件桥接。Bot API 超大文件会失败。</p>
          `;
          return;
        }

        const tone = bridge.ok ? 'ok' : 'error';
        const health = bridge.health || {};
        const rows = [
          ['后端', bridge.backend === 'workers-free' ? 'Workers Free' : '外置桥接'],
          ['域名', bridge.host || '未知'],
          ['健康状态', bridge.ok ? '在线' : `异常 (${bridge.status || 'unknown'})`],
          ['MTProto 连接', health.connected === undefined ? '未知' : (health.connected ? '已连' : '未连')],
          ['会话授权', health.authorized === undefined ? '未知' : (health.authorized ? '已授权' : '未授权')],
          ['缓存聊天', health.cachedPeers === undefined ? '未知' : String(health.cachedPeers)],
          ['最近连线', health.lastConnectedAt ? formatTime(health.lastConnectedAt) : '无'],
          ['最近下载', health.lastDownloadAt ? formatTime(health.lastDownloadAt) : '无'],
          ['错误', bridge.error || health.lastError || '无']
        ];

        bridgePanel.innerHTML = `
          <div class="bridge-panel__header">
            <strong>大文件桥接状态</strong>
            <span class="meta-chip bridge-panel__tone" data-tone="${tone}">${bridge.ok ? '在线' : '异常'}</span>
          </div>
          <p class="muted-text">当前主站的大文件回退路径指向 <code>${bridge.url}</code>。</p>
          <dl class="bridge-panel__grid">
            ${rows.map(([label, value]) => `<div><dt>${label}</dt><dd>${value}</dd></div>`).join('')}
          </dl>
        `;
      };

      const renderTelegramSummary = (payload) => {
        const webhookUrl = payload?.webhook?.url || '未配置';
        const pending = payload?.webhook?.pending_update_count ?? 0;
        const bot = payload?.bot?.username ? `@${payload.bot.username}` : '未知';
        const readAll = payload?.bot?.canReadAllGroupMessages;
        const bridge = payload?.bridge;
        const chips = [
          `Bot：${bot}`,
          `Webhook：${webhookUrl}`,
          `Pending：${pending}`,
          `群消息读取：${readAll === null ? '未知' : (readAll ? '已开启' : '未开启')}`,
          bridge?.configured ? `大文件桥：${bridge.ok ? '在线' : '异常'}` : '大文件桥：未配置',
          bridge?.configured ? `桥接后端：${bridge.backend === 'workers-free' ? 'Workers Free' : '外置'}` : null,
          bridge?.host ? `桥接域名：${bridge.host}` : null,
          bridge?.health?.connected !== undefined ? `桥连接：${bridge.health.connected ? '已连' : '未连'}` : null,
          bridge?.health?.authorized !== undefined ? `桥授权：${bridge.health.authorized ? '已授权' : '未授权'}` : null,
          bridge?.health?.cachedPeers !== undefined ? `桥缓存聊天：${bridge.health.cachedPeers}` : null,
          bridge?.health?.lastDownloadAt ? `桥最近下载：${formatTime(bridge.health.lastDownloadAt)}` : null,
          bridge?.error ? `桥错误：${bridge.error}` : null,
          payload?.syncState?.lastWebhookAt ? `最近 webhook：${formatTime(payload.syncState.lastWebhookAt)}` : null,
          payload?.syncState?.lastSyncAt ? `最近 sync：${formatTime(payload.syncState.lastSyncAt)}` : null,
          Number.isFinite(payload?.syncState?.offset) ? `offset：${payload.syncState.offset}` : null
        ].filter(Boolean);

        const buttons = telegramSummary.querySelectorAll('button');
        telegramSummary.innerHTML = [...buttons].map((button) => button.outerHTML).join('')
          + chips.map((part) => `<span class="meta-chip">${part}</span>`).join('');
        renderBridgePanel(bridge);
      };

      const buildCard = (item) => {
        const badges = [
          item.metadata?.ListType,
          item.metadata?.Label,
          item.metadata?.liked ? 'liked' : null,
          item.metadata?.source || null,
          item.metadata?.telegram?.mediaKind || null
        ]
          .filter((value) => value && value !== 'None')
          .map((value) => `<span class="badge">${value}</span>`)
          .join('');

        const preview = isVideo(item.name)
          ? `<video controls preload="metadata" src="${item.url}"></video>`
          : isAudio(item.name)
            ? `<div class="audio-card"><span>🎵</span><a href="${item.url}" target="_blank" rel="noreferrer">播放 / 打开</a></div>`
            : `<img loading="lazy" src="${item.url}" alt="${item.metadata?.fileName || item.davName || item.name}" />`;

        const telegramInfo = item.metadata?.telegram
          ? `
            <div><dt>聊天</dt><dd>${item.metadata.telegram.chatTitle || item.metadata.telegram.chatId || '未知'}</dd></div>
            <div><dt>消息</dt><dd>${item.metadata.telegram.messageId || '缺失'}</dd></div>
            <div><dt>远端删除</dt><dd>${item.canDeleteTelegram ? '支持' : '仅删 KV'}</dd></div>
          `
          : `<div><dt>聊天</dt><dd>未记录</dd></div><div><dt>消息</dt><dd>未记录</dd></div><div><dt>远端删除</dt><dd>仅删 KV</dd></div>`;

        const caption = item.metadata?.caption
          ? `<p class="muted-text">Caption: ${item.metadata.caption}</p>`
          : '';

        return `
          <article class="media-card" data-key="${item.name}">
            <div class="preview-frame">${preview}</div>
            <div class="media-copy">
              <strong title="${item.metadata?.fileName || item.davName || item.name}">${item.metadata?.fileName || item.davName || item.name}</strong>
              <p class="muted-text">${item.name}</p>
              <div class="meta-chip-row">
                <span class="meta-chip">${item.davPath || '未绑定 DAV 路径'}</span>
              </div>
              ${caption}
              <div class="badge-row">${badges || '<span class="badge muted">None</span>'}</div>
              <dl>
                <div><dt>时间</dt><dd>${formatTime(item.metadata?.TimeStamp)}</dd></div>
                <div><dt>大小</dt><dd>${formatBytes(item.metadata?.fileSize)}</dd></div>
                ${telegramInfo}
              </dl>
            </div>
            <div class="toolbar-row compact">
              <button type="button" class="ghost-button" data-action="copy" data-key="${item.name}">复制链接</button>
              <button type="button" class="ghost-button" data-action="rename" data-key="${item.name}">重命名</button>
              <button type="button" class="ghost-button" data-action="like" data-key="${item.name}">${item.metadata?.liked ? '取消收藏' : '收藏'}</button>
              <button type="button" class="ghost-button" data-action="white" data-key="${item.name}">白名单</button>
              <button type="button" class="ghost-button" data-action="block" data-key="${item.name}">黑名单</button>
              <button type="button" class="ghost-button danger" data-action="delete" data-key="${item.name}">真实删除</button>
              <button type="button" class="ghost-button" data-action="delete-kv" data-key="${item.name}">仅删KV</button>
            </div>
          </article>
        `;
      };

      const renderFolderContext = () => {
        const crumbs = buildBreadcrumbs(state.currentPath);
        breadcrumbs.innerHTML = crumbs.map((crumb, index) => {
          const isLast = index === crumbs.length - 1;
          return `
            <button type="button" class="breadcrumb-chip${isLast ? ' is-current' : ''}" data-action="open-folder" data-path="${crumb.path}">
              ${crumb.label}
            </button>
          `;
        }).join('<span class="breadcrumb-sep">/</span>');

        const counts = state.currentBrowse?.counts || { folders: 0, files: 0 };
        folderContext.innerHTML = `
          <span class="meta-chip">当前目录：${state.currentPath}</span>
          <span class="meta-chip">子目录：${counts.folders}</span>
          <span class="meta-chip">文件：${counts.files}</span>
        `;
      };

      const renderSummary = () => {
        const filtered = state.currentItems.filter((item) => matchesSearch(item, state.search));
        const deletable = filtered.filter((item) => item.canDeleteTelegram).length;
        const parts = [
          `当前目录文件：${filtered.length}`,
          `可远端删除：${deletable}`,
          state.search ? `搜索：${state.search}` : '搜索：全部',
          `目录视图：${state.currentPath}`
        ];
        summary.innerHTML = parts.map((part) => `<span class="meta-chip">${part}</span>`).join('');
      };

      const renderFiles = () => {
        const filtered = state.currentItems.filter((item) => matchesSearch(item, state.search));
        grid.innerHTML = filtered.length
          ? filtered.map(buildCard).join('')
          : '<div class="empty-state">当前目录下没有匹配文件。</div>';
        renderSummary();
      };

      const renderFolderTree = () => {
        const rootNode = {
          path: '/',
          name: '根目录'
        };

        const renderNode = (node) => {
          const cached = state.folderCache.get(node.path);
          const children = cached?.folders || [];
          const expanded = state.expandedFolders.has(node.path);
          const active = state.currentPath === node.path;
          return `
            <li class="folder-tree__item">
              <div class="folder-tree__row${active ? ' is-active' : ''}">
                <button type="button" class="folder-tree__toggle" data-action="toggle-folder" data-path="${node.path}">
                  ${expanded ? '▾' : '▸'}
                </button>
                <button type="button" class="folder-tree__link" data-action="open-folder" data-path="${node.path}">
                  ${node.name}
                </button>
              </div>
              ${expanded && children.length ? `<ul class="folder-tree__children">${children.map(renderNode).join('')}</ul>` : ''}
            </li>
          `;
        };

        folderTree.innerHTML = `<ul class="folder-tree__root">${renderNode(rootNode)}</ul>`;
      };

      const ensureExpandedAncestors = (path) => {
        let current = normalizePath(path);
        state.expandedFolders.add('/');
        while (current && current !== '/') {
          state.expandedFolders.add(current);
          current = getParentPath(current);
        }
      };

      const fetchTelegramStatus = async () => {
        const response = await fetch('/api/manage/telegram/status');
        const payload = await response.json().catch(() => ({ error: '无法解析 Telegram 状态。' }));
        if (!response.ok) {
          throw new Error(payload?.error || '获取 Telegram 状态失败。');
        }
        renderTelegramSummary(payload);
        return payload;
      };

      const postJson = async (path) => {
        const response = await fetch(path, { method: 'POST' });
        const payload = await response.json().catch(() => ({ error: '无法解析接口返回。' }));
        if (!response.ok) {
          throw new Error(payload?.error || payload?.hint || '操作失败。');
        }
        return payload;
      };

      const fetchFolderBrowse = async (path, { force = false, silent = false } = {}) => {
        const normalized = normalizePath(path);
        if (!force && state.folderCache.has(normalized)) {
          return state.folderCache.get(normalized);
        }

        if (!silent) {
          setStatus(`正在加载目录 ${normalized} ...`, 'busy');
        }

        const response = await fetch(`/api/manage/dav/browse?path=${encodeURIComponent(normalized)}`, {
          headers: { accept: 'application/json' }
        });
        const payload = await response.json().catch(() => ({ error: '无法解析目录响应。' }));
        if (!response.ok) {
          throw new Error(payload?.error || '目录加载失败。');
        }

        state.folderCache.set(normalized, payload);
        return payload;
      };

      const openFolder = async (path, { force = false, silent = false } = {}) => {
        const normalized = normalizePath(path);
        const payload = await fetchFolderBrowse(normalized, { force, silent });
        state.currentPath = normalized;
        state.currentBrowse = payload;
        state.currentItems = payload.files || [];
        ensureExpandedAncestors(normalized);
        renderFolderContext();
        renderFolderTree();
        renderFiles();
        syncUrl();
        if (!silent) {
          setStatus(`目录 ${normalized} 已加载。`, 'success');
        }
      };

      const refreshCurrentFolder = async () => {
        await openFolder(state.currentPath, { force: true });
      };

      const bootstrapFolders = async () => {
        await fetchFolderBrowse('/', { force: true, silent: true });
        if (state.currentPath === '/') {
          await openFolder('/', { force: true, silent: true });
          return;
        }

        const ancestors = [];
        let current = getParentPath(state.currentPath);
        while (current && current !== '/') {
          ancestors.unshift(current);
          current = getParentPath(current);
        }

        for (const ancestor of ancestors) {
          await fetchFolderBrowse(ancestor, { force: true, silent: true });
        }

        await openFolder(state.currentPath, { force: true, silent: true });
      };

      const createFolder = async () => {
        const requestedName = window.prompt('新目录名称（创建在当前目录下）', '');
        if (!requestedName) return;
        const folderName = requestedName.trim().replace(/^\/+|\/+$/g, '');
        if (!folderName) return;

        const response = await fetch(davUrl(joinPath(state.currentPath, folderName)), {
          method: 'MKCOL'
        });

        if (!response.ok) {
          const message = await response.text().catch(() => '创建目录失败。');
          throw new Error(message || '创建目录失败。');
        }

        state.folderCache.delete(state.currentPath);
        await openFolder(state.currentPath, { force: true });
        setStatus(`目录 ${folderName} 已创建。`, 'success');
      };

      const deleteCurrentFolder = async () => {
        if (state.currentPath === '/') {
          throw new Error('根目录不能删除。');
        }

        if (!window.confirm(`确认删除目录 ${state.currentPath}？这会递归删除目录下所有 DAV 文件映射，并尝试删除对应 Telegram 记录。`)) {
          return;
        }

        const currentPath = state.currentPath;
        const parentPath = getParentPath(currentPath) || '/';
        const response = await fetch(davUrl(currentPath), { method: 'DELETE' });
        if (!response.ok) {
          const message = await response.text().catch(() => '删除目录失败。');
          throw new Error(message || '删除目录失败。');
        }

        state.folderCache.delete(currentPath);
        state.folderCache.delete(parentPath);
        state.expandedFolders.delete(currentPath);
        await openFolder(parentPath, { force: true });
        setStatus(`目录 ${currentPath} 已删除。`, 'success');
      };

      const moveDavFile = async (item, nextName) => {
        const currentPath = item.davPath || joinPath(state.currentPath, item.davName || item.metadata?.fileName || item.name);
        const parentPath = getParentPath(currentPath) || '/';
        const destinationPath = joinPath(parentPath, nextName);
        const response = await fetch(davUrl(currentPath), {
          method: 'MOVE',
          headers: {
            destination: new URL(davUrl(destinationPath), window.location.origin).toString()
          }
        });

        if (!response.ok) {
          const message = await response.text().catch(() => 'DAV 重命名失败。');
          throw new Error(message || 'DAV 重命名失败。');
        }
      };

      form.addEventListener('submit', (event) => {
        event.preventDefault();
        state.search = form.search.value.trim();
        syncUrl();
        renderFiles();
      });

      form.search.addEventListener('input', () => {
        state.search = form.search.value.trim();
        syncUrl();
        renderFiles();
      });

      window.addEventListener('keydown', (event) => {
        if (event.key !== '/' || event.metaKey || event.ctrlKey || event.altKey) {
          return;
        }

        if (isEditableTarget(event.target)) {
          return;
        }

        event.preventDefault();
        form.search.focus();
        form.search.select();
      });

      root.addEventListener('click', async (event) => {
        const target = event.target instanceof Element ? event.target : null;
        const button = target?.closest('button[data-action]');
        if (!button) return;

        const action = button.dataset.action;
        const key = button.dataset.key;
        const path = button.dataset.path;

        if (action === 'toggle-tools') {
          state.leftCollapsed = !state.leftCollapsed;
          leftPanel.classList.toggle('is-collapsed', state.leftCollapsed);
          button.textContent = state.leftCollapsed ? '展开侧栏' : '收起侧栏';
          button.setAttribute('aria-expanded', String(!state.leftCollapsed));
          return;
        }

        if (action === 'toggle-view') {
          state.view = state.view === 'grid' ? 'waterfall' : 'grid';
          grid.dataset.view = state.view;
          viewChip.textContent = `视图：${state.view}`;
          syncUrl();
          return;
        }

        if (action === 'reset-search') {
          form.reset();
          state.search = '';
          syncUrl();
          renderFiles();
          return;
        }

        if (action === 'refresh-folder') {
          void refreshCurrentFolder();
          return;
        }

        if (action === 'root-folder') {
          void openFolder('/', { force: true });
          return;
        }

        if (action === 'toggle-folder' && path) {
          const normalized = normalizePath(path);
          if (state.expandedFolders.has(normalized)) {
            state.expandedFolders.delete(normalized);
            renderFolderTree();
            return;
          }

          state.expandedFolders.add(normalized);
          try {
            await fetchFolderBrowse(normalized, { silent: true });
          } catch (error) {
            setStatus(error instanceof Error ? error.message : '目录树展开失败。', 'error');
          }
          renderFolderTree();
          return;
        }

        if (action === 'open-folder' && path) {
          try {
            await openFolder(path, { force: false });
          } catch (error) {
            setStatus(error instanceof Error ? error.message : '目录跳转失败。', 'error');
          }
          return;
        }

        try {
          if (action === 'new-folder') {
            await createFolder();
            return;
          }

          if (action === 'delete-folder') {
            await deleteCurrentFolder();
            return;
          }

          if (action === 'telegram-status') {
            setStatus('正在获取 Telegram 状态...', 'busy');
            await fetchTelegramStatus();
            setStatus('Telegram 状态已刷新。', 'success');
            return;
          }

          if (action === 'bridge-warmup') {
            setStatus('正在执行桥接自检...', 'busy');
            const payload = await postJson('/api/manage/telegram/bridge-warmup');
            await fetchTelegramStatus();
            setStatus(payload?.message || '桥接自检完成。', payload?.bridge?.ok ? 'success' : 'busy');
            return;
          }

          if (action === 'telegram-sync') {
            setStatus('正在同步 Telegram 直传更新...', 'busy');
            const payload = await postJson('/api/manage/telegram/sync');
            await fetchTelegramStatus();
            state.folderCache.delete('/');
            await openFolder('/', { force: true, silent: true });
            setStatus(`同步完成：抓取 ${payload.fetched} 条，写入 ${payload.stored} 条。`, 'success');
            return;
          }

          if (action === 'telegram-webhook') {
            setStatus('正在配置 Telegram webhook...', 'busy');
            const payload = await postJson('/api/manage/telegram/webhook');
            renderTelegramSummary({
              bot: null,
              webhook: payload.webhookInfo,
              syncState: { offset: null, lastWebhookAt: Date.now(), lastSyncAt: null }
            });
            await fetchTelegramStatus();
            setStatus(`Webhook 已配置到 ${payload.webhookUrl}`, 'success');
            return;
          }
        } catch (error) {
          setStatus(error instanceof Error ? error.message : '操作失败。', 'error');
          return;
        }

        const current = state.currentItems.find((item) => item.name === key);
        const origin = window.location.origin;

        if (!current) return;

        try {
          if (action === 'copy') {
            await navigator.clipboard.writeText(`${origin}/file/${key}`);
            setStatus(`已复制 ${key}。`, 'success');
            return;
          }

          if (action === 'rename') {
            const nextName = window.prompt('新的文件名', current?.davName || current?.metadata?.fileName || key);
            if (!nextName) return;

            if (current.davPath) {
              await moveDavFile(current, nextName.trim());
              state.folderCache.delete(state.currentPath);
              await openFolder(state.currentPath, { force: true, silent: true });
              setStatus('文件名已更新。', 'success');
              return;
            }
          }

          if (action === 'delete' && !window.confirm(`确认删除 ${key}？若记录里带有 Telegram message_id，将同时删除 Telegram 原消息。`)) {
            return;
          }

          if (action === 'delete-kv' && !window.confirm(`确认仅删除 ${key} 的 KV 记录？Telegram 原消息将保留。`)) {
            return;
          }

          if (action === 'delete' && current.davPath) {
            const response = await fetch(davUrl(current.davPath), { method: 'DELETE' });
            if (!response.ok) {
              const message = await response.text().catch(() => '真实删除失败。');
              throw new Error(message || '真实删除失败。');
            }
            state.folderCache.delete(state.currentPath);
            await openFolder(state.currentPath, { force: true, silent: true });
            setStatus('真实删除完成。', 'success');
            return;
          }

          const endpoint = {
            like: 'toggleLike',
            white: 'white',
            block: 'block',
            delete: 'delete',
            'delete-kv': 'deleteKv'
          }[action];

          if (!endpoint) return;

          const response = await fetch(`/api/manage/${endpoint}/${encodeURIComponent(key)}`, { method: 'POST' });
          const payload = await response.json().catch(() => null);
          if (!response.ok) {
            if (action === 'delete') {
              const reason = payload?.error || '真实删除失败。';
              const shouldFallback = window.confirm(`${reason}

是否回退为“仅删KV”？`);
              if (shouldFallback) {
                const fallbackResponse = await fetch(`/api/manage/deleteKv/${encodeURIComponent(key)}`, { method: 'POST' });
                const fallbackPayload = await fallbackResponse.json().catch(() => null);
                if (!fallbackResponse.ok) {
                  throw new Error(fallbackPayload?.error || '仅删KV失败。');
                }
                setStatus(fallbackPayload?.warning || '已回退为仅删KV。', 'busy');
                state.folderCache.delete(state.currentPath);
                await openFolder(state.currentPath, { force: true, silent: true });
                return;
              }
            }

            throw new Error(payload?.error || `${action} 失败。`);
          }

          const message = payload?.warning || payload?.message || (action === 'delete-kv' ? '仅删 KV 完成。' : `${action} 完成。`);
          setStatus(message, payload?.warning ? 'busy' : 'success');
          state.folderCache.delete(state.currentPath);
          await openFolder(state.currentPath, { force: true, silent: true });
        } catch (error) {
          setStatus(error instanceof Error ? error.message : '操作失败。', 'error');
        }
      });

      void fetchTelegramStatus().catch((error) => {
        setStatus(error instanceof Error ? error.message : '获取 Telegram 状态失败。', 'error');
      });

      void bootstrapFolders().then(() => {
        setStatus(`目录 ${state.currentPath} 已加载。`, 'success');
      }).catch(async (error) => {
        if (state.currentPath !== '/') {
          try {
            state.currentPath = '/';
            await fetchFolderBrowse('/', { force: true, silent: true });
            await openFolder('/', { force: true, silent: true });
          } catch {}
        }
        setStatus(error instanceof Error ? error.message : '加载目录失败。', 'error');
      });
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init, { once: true });
  } else {
    init();
  }
})();
</script>

