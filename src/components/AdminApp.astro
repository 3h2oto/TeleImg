---
import AdminLeftPanel from './admin/AdminLeftPanel.astro';
import AdminCenterPanel from './admin/AdminCenterPanel.astro';
import AdminRightPanel from './admin/AdminRightPanel.astro';
import AdminUtilityDock from './admin/AdminUtilityDock.astro';
---

<>
  <section class="admin-shell admin-workspace-shell">
    <div class="admin-layout-grid">
      <AdminLeftPanel />
      <AdminCenterPanel />
      <AdminRightPanel />
    </div>
  </section>
  <AdminUtilityDock />
</>

<style>
  .admin-workspace-shell {
    padding: 20px;
  }

  .admin-layout-grid {
    display: flex;
    align-items: stretch;
    gap: 18px;
    min-height: calc(100vh - 120px);
  }

  .admin-pane {
    min-width: 0;
    border-radius: 24px;
    border: 1px solid rgba(168, 255, 96, 0.1);
    background: #0b0b0b;
    display: flex;
    overflow: hidden;
  }

  .admin-pane__rail {
    width: 68px;
    min-width: 68px;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 14px 0;
    border-right: 1px solid rgba(168, 255, 96, 0.08);
    background: linear-gradient(180deg, rgba(13, 13, 13, 0.98), rgba(9, 9, 9, 0.98));
  }

  .admin-pane__rail--right {
    order: 2;
    border-right: none;
    border-left: 1px solid rgba(168, 255, 96, 0.08);
  }

  .admin-pane__toggle {
    width: 42px;
    height: 42px;
    border-radius: 999px;
    border: 1px solid rgba(168, 255, 96, 0.14);
    background: #101010;
    color: var(--text);
    cursor: pointer;
  }

  .admin-pane__content {
    flex: 1;
    min-width: 0;
    padding: 20px 18px;
  }

  .admin-pane__hero,
  .admin-pane__group {
    min-width: 0;
  }

  .admin-pane__group-head {
    margin-bottom: 12px;
  }

  @media (max-width: 1280px) {
    .admin-layout-grid {
      flex-direction: column;
    }

    .admin-pane,
    .admin-stage {
      width: 100% !important;
    }

    .admin-pane__rail,
    .admin-pane__rail--right {
      order: 0;
      width: 100%;
      min-width: 0;
      padding: 12px;
      border-left: none;
      border-right: none;
      border-bottom: 1px solid rgba(168, 255, 96, 0.08);
      justify-content: flex-start;
    }
  }
</style>
