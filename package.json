{
  "name": "teleimg",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "dev:pages": "npm run build && wrangler pages dev dist --kv img_url --binding BASIC_USER=admin --binding BASIC_PASS=123 --persist-to ./.wrangler/state",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "ci": "npm run check && npm run test && npm run build",
    "cf:whoami": "wrangler whoami",
    "mtproto:login": "cargo run --manifest-path mtproto-bridge-rs/Cargo.toml --bin teleimg-mtproto-login --",
    "mtproto:bridge": "cargo run --manifest-path mtproto-bridge-rs/Cargo.toml --bin teleimg-mtproto-bridge --",
    "mtproto:worker:check": "npm --prefix workers-mtproto-bridge run check",
    "mtproto:worker:dev": "npm --prefix workers-mtproto-bridge run dev",
    "mtproto:worker:deploy": "npm --prefix workers-mtproto-bridge run deploy",
    "mtproto:worker:login": "node workers-mtproto-bridge/tools/login.mjs"
  },
  "dependencies": {
    "astro": "^6.2.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/node": "^24.10.1",
    "node-addon-api": "^8.7.0",
    "node-gyp": "^12.3.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5",
    "wrangler": "^4.87.0"
  }
}
